# .dockerignore

# Git files
.git
.gitignore

# Node modules - these are installed within the Docker build stages
node_modules

# Next.js build output directory (except for what's copied from builder)
.next/*
!.next/standalone
!.next/static

# Development environment files
.env
.env*.local
.env*.development
.env*.test

# IDE/Editor specific files
.vscode
*.code-workspace

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific files
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile
.dockerignore

# Documentation
README.md

# Test reports and coverage
coverage
.nyc_output
